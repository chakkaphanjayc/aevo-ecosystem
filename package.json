{
  "name": "aevo-ecosystem-local",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.21",
  "scripts": {
    "dev:hub": "bun run scripts/local-dev.ts hub",
    "dev:hub:tunnel": "AEVO_DEV_TUNNEL=1 bun run scripts/local-dev.ts hub",
    "dev:admin": "bun run scripts/local-dev.ts admin",
    "dev:admin:tunnel": "AEVO_DEV_TUNNEL=1 bun run scripts/local-dev.ts admin",
    "dev:play": "bun run scripts/local-dev.ts play",
    "dev:play:tunnel": "AEVO_DEV_TUNNEL=1 bun run scripts/local-dev.ts play",
    "dev:pos": "bun run scripts/local-dev.ts pos",
    "dev:pos:tunnel": "AEVO_DEV_TUNNEL=1 bun run scripts/local-dev.ts pos",
    "dev:hub+admin": "bun run scripts/local-dev.ts hub admin",
    "dev:hub+play": "bun run scripts/local-dev.ts hub play",
    "dev:hub+pos": "bun run scripts/local-dev.ts hub pos",
    "dev:play+pos": "bun run scripts/local-dev.ts play pos",
    "dev:go": "bun run --cwd aevo-go dev",
    "dev:go:tunnel": "AEVO_DEV_TUNNEL=1 AEVO_DEV_TUNNEL_AUTOSTART=1 bun run --cwd aevo-go dev",
    "dev:customer": "bun run --cwd aevo-go dev",
    "dev:apps": "bun run scripts/local-dev.ts play pos",
    "dev:all": "bun run scripts/local-dev.ts all",
    "dev:all:tunnel": "AEVO_DEV_TUNNEL=1 bun run scripts/local-dev.ts all",
    "sync:contracts": "bun run scripts/sync-contracts.ts",
    "check:local": "bun run scripts/check-local.ts all",
    "check:local:hub": "bun run scripts/check-local.ts hub",
    "check:local:admin": "bun run scripts/check-local.ts admin",
    "check:local:play": "bun run scripts/check-local.ts play",
    "check:local:pos": "bun run scripts/check-local.ts pos",
    "check:local:hub+play": "bun run scripts/check-local.ts hub play",
    "check:local:hub+admin": "bun run scripts/check-local.ts hub admin",
    "check:local:hub+pos": "bun run scripts/check-local.ts hub pos",
    "check:local:play+pos": "bun run scripts/check-local.ts play pos",
    "check:local:go": "bun run scripts/check-local.ts go",
    "check:hub:baseline": "bun run scripts/hub-baseline-check.ts",
    "check:admin:integration": "bun --env-file=aevo-hub/.env run scripts/check-admin-integration.ts",
    "check:feed:load": "bun run scripts/check-feed-load.ts",
    "benchmark:auth-cache": "bun --env-file=aevo-hub/.env run scripts/benchmark-auth-cache.ts",
    "test:all": "bun run scripts/test-all.ts",
    "test:integration": "bun run scripts/test-all.ts --integration",
    "test:tenant-security": "bun run scripts/test-tenant-security.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
